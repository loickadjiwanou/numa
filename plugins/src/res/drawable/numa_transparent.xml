<?xml version="1.0" encoding="utf-8"?>
<!-- Icône transparente pour la notification foreground.
     Un path vide fait crasher Android — le rectangle transparent ci-dessous
     produit un bitmap 24x24 entièrement alpha=0 : valide mais invisible. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:fillColor="#00000000"
        android:pathData="M0,0H24V24H0Z" />
</vector>
