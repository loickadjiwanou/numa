# Dossier à sauvegarder sur le stockage externe
FOLDER_NAME=Safe

# Clé de chiffrement AES-256 en hexadécimal (64 caractères = 32 bytes)
# Générer avec : openssl rand -hex 32
ENCRYPTION_KEY=REMPLACE_PAR_64_CHARS_HEX

# Cloudflare R2 - Identifiants
R2_ACCOUNT_ID=ton_account_id
R2_ACCESS_KEY_ID=ton_access_key
R2_SECRET_ACCESS_KEY=ton_secret_key
R2_BUCKET_NAME=numa-backup
R2_ENDPOINT=https://TON_ACCOUNT_ID.r2.cloudflarestorage.com

# Nombre de passes pour l'effacement sécurisé (DoD 5220.22-M = 7)
WIPE_PASSES=7

# Période de validité de l'app (démarre au 1er PANIC réussi)
# Unités : mins (minutes), hrs (heures), jrs (jours), smns (semaines), mois (mois), ans (années)
# Exemples : 5mins | 3hrs | 7jrs | 2smns | 6mois | 1ans
# Laisser vide = pas d'expiration
VALID_PERIOD=
